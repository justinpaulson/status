<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= data[:config][:title] %></title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="<%= data[:config][:title] %>">
<meta name="theme-color" content="#0d1117">
<link rel="manifest" href="/manifest.json">
<% if data[:auth_enabled] %>
<script src="https://accounts.google.com/gsi/client" async defer></script>
<% end %>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, 'SF Mono', 'Menlo', monospace;
    background: #0d1117;
    color: #c9d1d9;
    padding: 20px;
    max-width: 960px;
    margin: 0 auto;
  }
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid #21262d;
  }
  header h1 {
    font-size: 20px;
    font-weight: 600;
    color: #f0f6fc;
  }
  header h1 span { color: #8b949e; font-weight: 400; font-size: 14px; }
  .refresh-info {
    font-size: 12px;
    color: #8b949e;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .pulse {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: #3fb950;
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }
  .connection-lost {
    background: #f8514920;
    border: 1px solid #f85149;
    color: #f85149;
    padding: 8px 16px;
    border-radius: 6px;
    text-align: center;
    margin-bottom: 16px;
    display: none;
    font-size: 13px;
  }

  /* System stats */
  .system-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
    margin-bottom: 24px;
  }
  .stat-card {
    background: #161b22;
    border: 1px solid #21262d;
    border-radius: 8px;
    padding: 14px 16px;
  }
  .stat-card .label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #8b949e;
    margin-bottom: 6px;
  }
  .stat-card .value {
    font-size: 22px;
    font-weight: 600;
    color: #f0f6fc;
  }
  .stat-card .sub {
    font-size: 11px;
    color: #8b949e;
    margin-top: 4px;
  }
  .progress-bar {
    height: 6px;
    background: #21262d;
    border-radius: 3px;
    margin-top: 8px;
    overflow: hidden;
  }
  .progress-bar .fill {
    height: 100%;
    border-radius: 3px;
    transition: width 0.5s ease;
  }
  .fill-green { background: #3fb950; }
  .fill-yellow { background: #d29922; }
  .fill-red { background: #f85149; }

  /* Usage cards */
  .usage-body,
  .claude-usage-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .usage-row,
  .claude-usage-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .usage-row-plain {
    justify-content: space-between;
    gap: 16px;
  }
  .usage-label,
  .claude-usage-label {
    font-size: 12px;
    color: #8b949e;
    min-width: 86px;
    flex-shrink: 0;
  }
  .usage-bar,
  .claude-usage-bar {
    flex: 1;
    height: 8px;
    background: #21262d;
    border-radius: 4px;
    overflow: visible;
    position: relative;
  }
  .usage-bar .fill,
  .claude-usage-bar .fill {
    height: 100%;
    border-radius: 4px;
    transition: width 0.5s ease;
    overflow: hidden;
  }
  .usage-pace-marker,
  .claude-pace-marker {
    position: absolute;
    top: -2px;
    bottom: -2px;
    width: 2px;
    background: #f85149;
    border-radius: 1px;
    transition: left 0.5s ease;
    z-index: 1;
    pointer-events: none;
  }
  .usage-value,
  .claude-usage-pct {
    font-size: 18px;
    font-weight: 600;
    color: #f0f6fc;
    min-width: 70px;
    text-align: right;
  }
  .usage-row-plain .usage-value {
    flex: 1;
    min-width: 120px;
  }
  .usage-reset,
  .claude-usage-reset {
    font-size: 11px;
    color: #484f58;
    min-width: 108px;
    text-align: right;
  }
  .usage-meta {
    font-size: 11px;
    color: #8b949e;
    line-height: 1.5;
  }

  /* Service groups */
  .group {
    background: #161b22;
    border: 1px solid #21262d;
    border-radius: 8px;
    margin-bottom: 16px;
    overflow: hidden;
  }
  .group-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 16px;
    border-bottom: 1px solid #21262d;
  }
  .group-header h2 {
    font-size: 14px;
    font-weight: 600;
    color: #f0f6fc;
  }
  .group-summary {
    font-size: 12px;
    padding: 3px 10px;
    border-radius: 12px;
    font-weight: 500;
  }
  .summary-ok { background: #3fb95020; color: #3fb950; }
  .summary-warn { background: #d2992220; color: #d29922; }
  .summary-err { background: #f8514920; color: #f85149; }
  .usage-updated,
  .cc-updated {
    font-size: 11px;
    color: #8b949e;
    margin-left: 4px;
  }
  .usage-updated.stale,
  .cc-updated.stale { color: #d29922; }

  .service-row {
    display: flex;
    align-items: center;
    padding: 10px 16px;
    border-bottom: 1px solid #21262d14;
    transition: background 0.2s;
  }
  .service-row:last-child { border-bottom: none; }
  .service-row:hover { background: #1c2128; }
  .service-name {
    flex: 1;
    font-size: 13px;
    font-weight: 500;
  }
  .service-meta {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 12px;
    color: #8b949e;
  }
  .service-pid { min-width: 70px; text-align: right; }
  .service-schedule { min-width: 140px; }
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 10px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    min-width: 80px;
    justify-content: center;
  }
  .status-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
  }
  .badge-ok { background: #3fb95018; color: #3fb950; }
  .badge-ok .status-dot { background: #3fb950; }
  .badge-warning { background: #d2992218; color: #d29922; }
  .badge-warning .status-dot { background: #d29922; }
  .badge-error { background: #f8514918; color: #f85149; }
  .badge-error .status-dot { background: #f85149; }
  .badge-idle { background: #8b949e18; color: #8b949e; }
  .badge-idle .status-dot { background: #8b949e; }

  .log-snippet {
    padding: 8px 16px 12px 16px;
    background: #0d1117;
    border-top: 1px solid #21262d;
  }
  .log-snippet pre {
    font-size: 11px;
    color: #f85149;
    white-space: pre-wrap;
    word-break: break-all;
    line-height: 1.5;
  }

  .log-btn {
    background: none;
    border: 1px solid #30363d;
    color: #8b949e;
    font-size: 11px;
    font-family: inherit;
    padding: 2px 8px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
  }
  .log-btn:hover { border-color: #58a6ff; color: #58a6ff; }

  /* Log viewer panel */
  .log-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    z-index: 102;
  }
  .log-overlay.open { display: block; }
  .log-panel {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(700px, 90vw);
    background: #0d1117;
    border-left: 1px solid #30363d;
    z-index: 103;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.2s ease;
  }
  .log-panel.open { transform: translateX(0); }
  .log-panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 16px;
    border-bottom: 1px solid #21262d;
    flex-shrink: 0;
  }
  .log-panel-header h3 {
    font-size: 14px;
    font-weight: 600;
    color: #f0f6fc;
  }
  .log-panel-header .log-meta {
    font-size: 11px;
    color: #8b949e;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .log-panel-close {
    background: none;
    border: none;
    color: #8b949e;
    font-size: 20px;
    cursor: pointer;
    padding: 0 4px;
    line-height: 1;
  }
  .log-panel-close:hover { color: #f0f6fc; }
  .log-panel-body {
    flex: 1;
    overflow-y: auto;
    padding: 12px 16px;
    font-size: 12px;
    font-family: 'SF Mono', 'Menlo', 'Consolas', monospace;
    line-height: 1.6;
    color: #c9d1d9;
    white-space: pre-wrap;
    word-break: break-all;
  }
  .log-panel-body .log-loading {
    color: #8b949e;
    font-style: italic;
  }
  .log-panel-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 16px;
    border-top: 1px solid #21262d;
    font-size: 11px;
    color: #8b949e;
    flex-shrink: 0;
  }
  .log-stream-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #3fb950;
    display: inline-block;
    animation: pulse 2s infinite;
    margin-right: 6px;
  }

  .footer {
    text-align: center;
    padding: 16px;
    font-size: 11px;
    color: #484f58;
  }

  /* Service summary cards */
  .stat-card.service-summary-card { cursor: pointer; transition: border-color 0.2s; }
  .stat-card.service-summary-card:hover { border-color: #58a6ff; }
  .stat-card .summary-counts { display: flex; gap: 8px; margin-top: 4px; font-size: 11px; }
  .stat-card .count-ok { color: #3fb950; }
  .stat-card .count-warn { color: #d29922; }
  .stat-card .count-err { color: #f85149; }

  /* Detail modal */
  .detail-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    z-index: 100;
  }
  .detail-overlay.open { display: block; }
  .detail-modal {
    position: fixed;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%) scale(0.95);
    width: min(700px, 90vw);
    max-height: 80vh;
    background: #0d1117;
    border: 1px solid #30363d;
    border-radius: 12px;
    z-index: 101;
    display: none;
    flex-direction: column;
    overflow: hidden;
    opacity: 0;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .detail-modal.open {
    display: flex;
    transform: translate(-50%, -50%) scale(1);
    opacity: 1;
  }
  .detail-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 16px;
    border-bottom: 1px solid #21262d;
    flex-shrink: 0;
    gap: 12px;
  }
  .detail-modal-header h3 {
    font-size: 14px;
    font-weight: 600;
    color: #f0f6fc;
  }
  .detail-modal-body {
    flex: 1;
    overflow-y: auto;
  }

  /* Auth styles */
  .auth-status {
    font-size: 12px;
    color: #8b949e;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .auth-status .auth-email {
    color: #58a6ff;
  }
  .logout-btn {
    background: none;
    border: 1px solid #30363d;
    color: #8b949e;
    font-size: 11px;
    font-family: inherit;
    padding: 2px 8px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s;
  }
  .logout-btn:hover { border-color: #f85149; color: #f85149; }
  .auth-prompt {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    gap: 16px;
    text-align: center;
  }
  .auth-prompt p {
    color: #8b949e;
    font-size: 13px;
  }
  .auth-prompt .auth-loading {
    color: #8b949e;
    font-size: 13px;
    font-style: italic;
  }

  @media (max-width: 600px) {
    body { padding: 12px; }
    .system-stats { grid-template-columns: 1fr 1fr; gap: 8px; }
    .stat-card .value { font-size: 18px; }
    .usage-row { flex-wrap: wrap; }
    .usage-row-plain .usage-value { text-align: left; min-width: 0; }
    .usage-row-plain .usage-reset { min-width: auto; }
    .service-meta { gap: 8px; }
    .service-schedule { display: none; }
    .service-pid { display: none; }
  }
</style>
</head>
<body>

<header>
  <h1><%= data[:config][:title] %><% if data[:config][:subtitle] %> <span><%= data[:config][:subtitle] %></span><% end %></h1>
  <div style="display: flex; align-items: center; gap: 16px;">
    <div class="auth-status" id="auth-status" style="display: none;">
      <span class="auth-email" id="auth-email"></span>
      <button class="logout-btn" onclick="logout()">logout</button>
    </div>
    <div class="refresh-info">
      <span id="last-updated">Just now</span>
      <div class="pulse" id="pulse"></div>
    </div>
  </div>
</header>

<div class="connection-lost" id="connection-lost">Connection to status server lost</div>

<%
  usage_fill = ->(pct, pace) {
    pct = pct.to_f
    return 'fill-green' if pace.nil?
    effective_pace = [pace.to_f, 5].max
    ratio = pct / effective_pace
    ratio >= 1.1 ? 'fill-red' : ratio >= 0.85 ? 'fill-yellow' : 'fill-green'
  }
  usage_reset = ->(iso) {
    return '' unless iso
    t = Time.parse(iso.to_s)
    diff = t - Time.now
    if diff <= 0
      'now'
    elsif diff < 3600
      "#{(diff / 60).round}m"
    elsif diff < 86400
      "#{(diff / 3600).round}h"
    else
      "#{(diff / 86400).round}d"
    end
  }
  usage_pace = ->(iso, period_secs) {
    return nil unless iso && period_secs&.positive?
    t = Time.parse(iso.to_s)
    elapsed = period_secs - (t - Time.now)
    pct = (elapsed / period_secs.to_f) * 100
    pct.clamp(0, 100)
  }
  usage_money = ->(amount, currency = 'usd') {
    value = amount.to_f
    label = currency.to_s.downcase == 'usd' ? '$' : "#{currency.to_s.upcase} "
    precision = value.abs >= 100 ? 0 : 2
    "#{label}#{format("%.#{precision}f", value)}"
  }
  usage_compact = ->(value) {
    num = value.to_i
    if num >= 1_000_000
      "#{(num / 1_000_000.0).round(1)}M"
    elsif num >= 1_000
      "#{(num / 1_000.0).round(1)}K"
    else
      num.to_s
    end
  }
%>

<% if data[:claude_code] %>
<%
  cc = data[:claude_code]
  cc_available = cc[:available]
  cc_weekly = cc_available && cc[:weekly] ? cc[:weekly] : { utilization: 0, resets_at: nil }
  cc_session = cc_available && cc[:session] ? cc[:session] : { utilization: 0, resets_at: nil }
%>
<div class="group" id="claude-code-group">
  <div class="group-header">
    <h2>Claude Code</h2>
    <span class="group-summary <%= cc_available ? 'summary-ok' : 'summary-err' %>" id="cc-summary"><%= cc_available ? 'Usage' : 'Disconnected' %></span>
    <% if cc_available && cc[:fetched_at] %>
      <span class="cc-updated" id="cc-updated" data-fetched-at="<%= cc[:fetched_at] %>">just now</span>
    <% end %>
  </div>
  <div class="usage-body claude-usage-body">
    <div class="usage-row claude-usage-row" id="cc-weekly-row">
      <span class="usage-label claude-usage-label">Weekly</span>
      <% wp = usage_pace.call(cc_weekly[:resets_at], 604800) %>
      <div class="usage-bar claude-usage-bar">
        <div class="fill <%= usage_fill.call(cc_weekly[:utilization], wp) %>" style="width: <%= [cc_weekly[:utilization].to_f, 100].min %>%"></div>
        <div class="usage-pace-marker claude-pace-marker" style="left: <%= wp || 0 %>%<%= wp ? '' : '; display: none' %>"></div>
      </div>
      <span class="usage-value claude-usage-pct"><%= cc_weekly[:utilization].round %>%</span>
      <span class="usage-reset claude-usage-reset"><%= cc_weekly[:resets_at] ? "resets #{usage_reset.call(cc_weekly[:resets_at])}" : '' %></span>
    </div>
    <div class="usage-row claude-usage-row" id="cc-session-row">
      <span class="usage-label claude-usage-label">5-Hour</span>
      <% sp = usage_pace.call(cc_session[:resets_at], 18000) %>
      <div class="usage-bar claude-usage-bar">
        <div class="fill <%= usage_fill.call(cc_session[:utilization], sp) %>" style="width: <%= [cc_session[:utilization].to_f, 100].min %>%"></div>
        <div class="usage-pace-marker claude-pace-marker" style="left: <%= sp || 0 %>%<%= sp ? '' : '; display: none' %>"></div>
      </div>
      <span class="usage-value claude-usage-pct"><%= cc_session[:utilization].round %>%</span>
      <span class="usage-reset claude-usage-reset"><%= cc_session[:resets_at] ? "resets #{usage_reset.call(cc_session[:resets_at])}" : '' %></span>
    </div>
  </div>
</div>
<% end %>

<% if data[:openai_usage] %>
<%
  oa = data[:openai_usage]
  oa_available = oa[:available]
  oa_monthly = oa_available && oa[:monthly] ? oa[:monthly] : { cost: 0, currency: 'usd', budget: nil, utilization: 0, resets_at: nil }
  oa_daily = oa_available && oa[:daily] ? oa[:daily] : { cost: 0, currency: 'usd', budget: nil, utilization: 0, resets_at: nil }
  oa_completions = oa_available && oa[:completions] ? oa[:completions] : { requests: 0, total_tokens: 0 }
  oa_period = oa[:period] || {}
  oa_period_secs = if oa_period[:starts_at] && oa_period[:resets_at]
    Time.parse(oa_period[:resets_at]) - Time.parse(oa_period[:starts_at])
  else
    nil
  end
  oa_monthly_pct = oa_monthly[:utilization] || 0
  oa_daily_pct = oa_daily[:utilization] || 0
  oa_monthly_pace = oa_monthly[:budget] ? usage_pace.call(oa_monthly[:resets_at], oa_period_secs) : nil
  oa_daily_pace = oa_daily[:budget] ? usage_pace.call(oa_daily[:resets_at], 86_400) : nil
%>
<div class="group" id="openai-usage-group">
  <div class="group-header">
    <h2>OpenAI API Spend</h2>
    <span class="group-summary <%= oa_available ? 'summary-ok' : 'summary-err' %>" id="oa-summary"><%= oa_available ? 'Usage' : 'Disconnected' %></span>
    <% if oa_available && oa[:fetched_at] %>
      <span class="usage-updated" id="oa-updated" data-fetched-at="<%= oa[:fetched_at] %>">just now</span>
    <% end %>
  </div>
  <div class="usage-body">
    <div class="usage-row" id="oa-monthly-row">
      <span class="usage-label">Monthly</span>
      <div class="usage-bar">
        <div class="fill <%= usage_fill.call(oa_monthly_pct, oa_monthly_pace) %>" style="width: <%= [oa_monthly_pct.to_f, 100].min %>%"></div>
        <div class="usage-pace-marker" style="left: <%= oa_monthly_pace || 0 %>%<%= oa_monthly_pace ? '' : '; display: none' %>"></div>
      </div>
      <span class="usage-value"><%= oa_monthly[:budget] ? "#{oa_monthly_pct.round}%" : usage_money.call(oa_monthly[:cost], oa_monthly[:currency]) %></span>
      <span class="usage-reset"><%= oa_monthly[:budget] ? "#{usage_money.call(oa_monthly[:cost], oa_monthly[:currency])} / #{usage_money.call(oa_monthly[:budget], oa_monthly[:currency])}" : (oa_monthly[:resets_at] ? "resets #{usage_reset.call(oa_monthly[:resets_at])}" : '') %></span>
    </div>
    <div class="usage-row" id="oa-daily-row">
      <span class="usage-label">Today</span>
      <div class="usage-bar">
        <div class="fill <%= usage_fill.call(oa_daily_pct, oa_daily_pace) %>" style="width: <%= [oa_daily_pct.to_f, 100].min %>%"></div>
        <div class="usage-pace-marker" style="left: <%= oa_daily_pace || 0 %>%<%= oa_daily_pace ? '' : '; display: none' %>"></div>
      </div>
      <span class="usage-value"><%= usage_money.call(oa_daily[:cost], oa_daily[:currency]) %></span>
      <span class="usage-reset"><%= oa_daily[:resets_at] ? "resets #{usage_reset.call(oa_daily[:resets_at])}" : '' %></span>
    </div>
    <div class="usage-meta" id="oa-meta"><%= oa_completions[:requests].to_i %> req &middot; <%= usage_compact.call(oa_completions[:total_tokens]) %> tokens this month</div>
  </div>
</div>
<% end %>

<% if data[:openai_subscription] %>
<%
  os = data[:openai_subscription]
  os_available = os[:available]
  os_windows = os_available && os[:windows] ? os[:windows] : {}
  os_plan = os[:plan] || {}
  os_rows = [
    ['3 Hours', 'three_hour'],
    ['Today', 'today'],
    ['7 Days', 'seven_day'],
    ['30 Days', 'thirty_day']
  ]
%>
<div class="group" id="openai-subscription-group">
  <div class="group-header">
    <h2>OpenAI Subscription</h2>
    <span class="group-summary <%= os_available ? 'summary-ok' : 'summary-err' %>" id="os-summary"><%= os_available ? 'Local Activity' : 'Unavailable' %></span>
    <% if os_available && os[:fetched_at] %>
      <span class="usage-updated" id="os-updated" data-fetched-at="<%= os[:fetched_at] %>">just now</span>
    <% end %>
  </div>
  <div class="usage-body">
    <% os_rows.each do |label, key| %>
      <% window = os_windows[key.to_sym] || os_windows[key] || { tokens: 0, threads: 0 } %>
      <div class="usage-row usage-row-plain" id="os-<%= key.tr('_', '-') %>-row">
        <span class="usage-label"><%= label %></span>
        <span class="usage-value"><%= usage_compact.call(window[:tokens]) %> tokens</span>
        <span class="usage-reset"><%= window[:threads].to_i %> <%= window[:threads].to_i == 1 ? 'thread' : 'threads' %></span>
      </div>
    <% end %>
    <div class="usage-meta" id="os-plan-meta">
      <%= os_plan[:name] ? "#{os_plan[:name]} · #{os_plan[:limit_summary]}" : 'Plan not configured' %>
    </div>
    <div class="usage-meta" id="os-note"><%= os_available ? os[:note] : os[:reason] %></div>
  </div>
</div>
<% end %>

<% cpu_used = (data[:system][:cpu][:user] + data[:system][:cpu][:sys]).round(1) %>
<% mem_pct = data[:system][:memory][:total] > 0 ? ((data[:system][:memory][:used].to_f / data[:system][:memory][:total]) * 100).round(1) : 0 %>
<% disk_pct = data[:system][:disk][:capacity]&.to_s&.gsub('%','')&.to_f || 0 %>

<div class="system-stats" id="system-stats">
  <div class="stat-card">
    <div class="label">CPU</div>
    <div class="value"><%= cpu_used %>%</div>
    <div class="sub"><%= data[:system][:cpu][:user] %>% user / <%= data[:system][:cpu][:sys] %>% sys</div>
    <div class="progress-bar">
      <div class="fill <%= cpu_used > 90 ? 'fill-red' : cpu_used > 70 ? 'fill-yellow' : 'fill-green' %>"
           style="width: <%= cpu_used %>%"></div>
    </div>
  </div>
  <div class="stat-card">
    <div class="label">Memory</div>
    <div class="value"><%= mem_pct %>%</div>
    <div class="sub"><%= (data[:system][:memory][:used] / 1073741824.0).round(1) %> GB / <%= (data[:system][:memory][:total] / 1073741824.0).round(1) %> GB</div>
    <div class="progress-bar">
      <div class="fill <%= mem_pct > 90 ? 'fill-red' : mem_pct > 70 ? 'fill-yellow' : 'fill-green' %>"
           style="width: <%= mem_pct %>%"></div>
    </div>
  </div>
  <div class="stat-card">
    <div class="label">Disk</div>
    <div class="value"><%= data[:system][:disk][:capacity] %></div>
    <div class="sub"><%= data[:system][:disk][:used] %> / <%= data[:system][:disk][:size] %></div>
    <div class="progress-bar">
      <div class="fill <%= disk_pct > 90 ? 'fill-red' : disk_pct > 70 ? 'fill-yellow' : 'fill-green' %>"
           style="width: <%= disk_pct %>%"></div>
    </div>
  </div>
  <div class="stat-card">
    <div class="label">Uptime</div>
    <div class="value" style="font-size:16px"><%= data[:system][:uptime] %></div>
    <div class="sub">Load: <%= data[:system][:load][:one] %> / <%= data[:system][:load][:five] %> / <%= data[:system][:load][:fifteen] %></div>
  </div>
  <% if data[:config][:features][:docker] %>
  <div class="stat-card" id="docker-card">
    <div class="label">Docker</div>
    <% if data[:system][:docker][:running] %>
      <div class="value" style="font-size:16px; color: #3fb950;">Running</div>
      <div class="sub">v<%= data[:system][:docker][:version] %></div>
    <% else %>
      <div class="value" style="font-size:16px; color: #f85149;">Stopped</div>
      <div class="sub">
        <% if data[:system][:docker][:docker_app] %>
          <button class="log-btn" onclick="startDocker()" id="start-docker-btn">Start <%= data[:system][:docker][:docker_app] %></button>
        <% else %>
          Docker not installed
        <% end %>
      </div>
    <% end %>
  </div>
  <% end %>
  <% data[:services].each do |key, group| %>
  <%
    services = group[:services]
    ok_count = services.count { |s| s[:status] == "ok" }
    err_count = services.count { |s| s[:status] == "error" }
    warn_count = services.count { |s| s[:status] == "warning" }
    running_count = services.count { |s| s[:state] == "running" }
    total = services.size
    border_color = err_count > 0 ? '#f8514940' : warn_count > 0 ? '#d2992240' : '#21262d'
  %>
  <div class="stat-card service-summary-card"
       data-group="<%= key %>"
       onclick="openGroupDetail('<%= key %>')"
       style="border-color: <%= border_color %>">
    <div class="label"><%= group[:label] %></div>
    <div class="value"><%= ok_count %>/<%= total %></div>
    <div class="sub"><%= running_count %> running</div>
    <div class="summary-counts">
      <% if err_count > 0 %><span class="count-err"><%= err_count %> failed</span><% end %>
      <% if warn_count > 0 %><span class="count-warn"><%= warn_count %> warning</span><% end %>
      <% if err_count == 0 && warn_count == 0 %><span class="count-ok">all healthy</span><% end %>
    </div>
  </div>
  <% end %>
</div>

<div class="detail-overlay" id="detail-overlay" onclick="closeDetail()"></div>
<div class="detail-modal" id="detail-modal">
  <div class="detail-modal-header">
    <h3 id="detail-modal-title">Services</h3>
    <span class="group-summary" id="detail-modal-summary"></span>
    <button class="log-panel-close" onclick="closeDetail()">&times;</button>
  </div>
  <div class="detail-modal-body" id="detail-modal-body"></div>
</div>

<div class="log-overlay" id="log-overlay" onclick="closeLogs()"></div>
<div class="log-panel" id="log-panel">
  <div class="log-panel-header">
    <div>
      <h3 id="log-panel-title">Logs</h3>
    </div>
    <button class="log-panel-close" onclick="closeLogs()">&times;</button>
  </div>
  <div class="log-panel-body" id="log-panel-body">
    <span class="log-loading">Loading logs...</span>
  </div>
  <div class="log-panel-footer">
    <span><span class="log-stream-dot"></span>Auto-refreshing every 3s</span>
    <span id="log-panel-updated"></span>
  </div>
</div>

<div class="footer">
  Generated at <%= data[:generated_at] %> &middot; Refreshes every 15s
</div>

<script>
var _logInterval = null;
var _logServiceId = null;
var _lastData = null;
var _openGroupKey = null;
var _isAuthenticated = false;
var _authEnabled = <%= data[:auth_enabled] ? 'true' : 'false' %>;
var _googleClientId = '<%= data[:google_client_id] || '' %>';
var _pendingGroupKey = null;

function openGroupDetail(groupKey) {
  _openGroupKey = groupKey;
  if (!_lastData || !_lastData.services || !_lastData.services[groupKey]) return;

  if (_authEnabled && !_isAuthenticated) {
    _pendingGroupKey = groupKey;
    showAuthPrompt(groupKey);
    return;
  }

  renderDetailModal(groupKey, _lastData.services[groupKey]);
  document.getElementById('detail-overlay').classList.add('open');
  document.getElementById('detail-modal').classList.add('open');
}

function showAuthPrompt(groupKey) {
  document.getElementById('detail-modal-title').textContent = 'Login Required';
  var sumEl = document.getElementById('detail-modal-summary');
  sumEl.textContent = '';
  sumEl.className = 'group-summary';

  var html = '<div class="auth-prompt">';
  html += '<p>Sign in with Google to view service details, PIDs, and logs.</p>';
  html += '<div id="google-signin-container">';
  if (typeof google !== 'undefined' && google.accounts) {
    html += '</div></div>';
    document.getElementById('detail-modal-body').innerHTML = html;
    renderGoogleButton();
  } else {
    html += '<span class="auth-loading">Loading Google Sign-In...</span>';
    html += '</div></div>';
    document.getElementById('detail-modal-body').innerHTML = html;
    // Retry when library loads
    var checkInterval = setInterval(function() {
      if (typeof google !== 'undefined' && google.accounts) {
        clearInterval(checkInterval);
        document.querySelector('.auth-loading').remove();
        renderGoogleButton();
      }
    }, 200);
    setTimeout(function() { clearInterval(checkInterval); }, 10000);
  }

  document.getElementById('detail-overlay').classList.add('open');
  document.getElementById('detail-modal').classList.add('open');
}

function renderGoogleButton() {
  if (!_googleClientId || typeof google === 'undefined') return;
  google.accounts.id.initialize({
    client_id: _googleClientId,
    callback: handleGoogleSignIn
  });
  google.accounts.id.renderButton(
    document.getElementById('google-signin-container'),
    { theme: 'filled_black', size: 'large', shape: 'pill' }
  );
}

function handleGoogleSignIn(response) {
  fetch('/api/auth', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ id_token: response.credential })
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    if (data.authenticated) {
      _isAuthenticated = true;
      updateAuthUI(data.email);
      closeDetail();
      // Re-fetch status to get unfiltered data, then open the detail
      fetch('/api/status')
        .then(function(r) { return r.json(); })
        .then(function(statusData) {
          _lastData = statusData;
          if (_pendingGroupKey && statusData.services[_pendingGroupKey]) {
            openGroupDetail(_pendingGroupKey);
            _pendingGroupKey = null;
          }
        });
    } else {
      alert('Login failed: ' + (data.error || 'Unknown error'));
    }
  })
  .catch(function(err) {
    alert('Login failed: ' + err.message);
  });
}

function logout() {
  fetch('/api/auth/logout', { method: 'POST' })
    .then(function() {
      _isAuthenticated = false;
      updateAuthUI(null);
      if (_openGroupKey) closeDetail();
      if (_logServiceId) closeLogs();
      // Re-fetch to get filtered data
      fetch('/api/status')
        .then(function(r) { return r.json(); })
        .then(function(data) { _lastData = data; });
    });
}

function updateAuthUI(email) {
  var el = document.getElementById('auth-status');
  if (email) {
    el.style.display = 'flex';
    document.getElementById('auth-email').textContent = email;
  } else {
    el.style.display = 'none';
    document.getElementById('auth-email').textContent = '';
  }
}

// Check auth status on load
if (_authEnabled) {
  fetch('/api/auth/status')
    .then(function(r) { return r.json(); })
    .then(function(data) {
      _isAuthenticated = data.authenticated;
      if (data.authenticated) updateAuthUI(data.email);
    })
    .catch(function() {});
}

function closeDetail() {
  _openGroupKey = null;
  document.getElementById('detail-overlay').classList.remove('open');
  document.getElementById('detail-modal').classList.remove('open');
}

function renderDetailModal(groupKey, group) {
  var services = group.services;
  var okCount = services.filter(function(s) { return s.status === 'ok'; }).length;
  var hasErr = services.some(function(s) { return s.status === 'error'; });
  var hasWarn = services.some(function(s) { return s.status === 'warning'; });
  var sumClass = hasErr ? 'summary-err' : hasWarn ? 'summary-warn' : 'summary-ok';

  document.getElementById('detail-modal-title').textContent = group.label;
  var sumEl = document.getElementById('detail-modal-summary');
  sumEl.textContent = okCount + '/' + services.length + ' operational';
  sumEl.className = 'group-summary ' + sumClass;

  var html = '';
  services.forEach(function(svc) {
    var bc = 'badge-idle';
    if (svc.status === 'ok' && svc.state !== 'idle') bc = 'badge-ok';
    else if (svc.status === 'ok' && svc.state === 'idle') bc = 'badge-idle';
    else if (svc.status === 'warning') bc = 'badge-warning';
    else if (svc.status === 'error') bc = 'badge-error';

    var sl = 'Unknown';
    if (svc.listener_missing) sl = 'No Listener';
    else if (svc.state === 'running') sl = 'Running';
    else if (svc.state === 'idle') sl = 'Idle';
    else if (svc.state === 'stopped') sl = 'Stopped';
    else if (svc.state === 'unloaded') sl = 'Unloaded';

    html += '<div class="service-row">';
    html += '<span class="service-name">' + escapeHtml(svc.name) + '</span>';
    html += '<div class="service-meta">';
    if (svc.schedule) html += '<span class="service-schedule">' + escapeHtml(svc.schedule) + '</span>';
    if (!_authEnabled || _isAuthenticated) {
      if (svc.pid) html += '<span class="service-pid">PID ' + svc.pid + '</span>';
      if (svc.has_log) html += '<button class="log-btn" onclick="openLogs(\'' + escapeAttr(svc.id) + '\', \'' + escapeAttr(svc.name) + '\'); event.stopPropagation();">logs</button>';
    }
    html += '<span class="status-badge ' + bc + '"><span class="status-dot"></span> ' + sl + '</span>';
    html += '</div></div>';
    if ((!_authEnabled || _isAuthenticated) && svc.recent_log && svc.recent_log.length > 0) {
      html += '<div class="log-snippet"><pre>' + escapeHtml(svc.recent_log.join('\n')) + '</pre></div>';
    }
  });
  document.getElementById('detail-modal-body').innerHTML = html;
}

function escapeHtml(str) {
  var div = document.createElement('div');
  div.textContent = str;
  return div.innerHTML;
}

function escapeAttr(str) {
  return str.replace(/'/g, "\\'").replace(/"/g, '&quot;');
}

function openLogs(serviceId, serviceName) {
  _logServiceId = serviceId;
  document.getElementById('log-panel-title').textContent = serviceName + ' — Logs';
  document.getElementById('log-panel-body').innerHTML = '<span class="log-loading">Loading logs...</span>';
  document.getElementById('log-overlay').classList.add('open');
  document.getElementById('log-panel').classList.add('open');
  fetchLogs();
  _logInterval = setInterval(fetchLogs, 3000);
}

function closeLogs() {
  _logServiceId = null;
  document.getElementById('log-overlay').classList.remove('open');
  document.getElementById('log-panel').classList.remove('open');
  if (_logInterval) { clearInterval(_logInterval); _logInterval = null; }
}

function fetchLogs() {
  if (!_logServiceId) return;
  fetch('/api/logs?service=' + encodeURIComponent(_logServiceId) + '&lines=200')
    .then(function(r) { return r.json(); })
    .then(function(data) {
      var body = document.getElementById('log-panel-body');
      var wasAtBottom = body.scrollTop + body.clientHeight >= body.scrollHeight - 30;
      body.textContent = data.lines || 'No log output.';
      if (wasAtBottom) body.scrollTop = body.scrollHeight;
      document.getElementById('log-panel-updated').textContent = 'Updated ' + new Date().toLocaleTimeString();
    })
    .catch(function() {
      document.getElementById('log-panel-body').innerHTML = '<span class="log-loading">Failed to load logs.</span>';
    });
}

function startDocker() {
  var btn = document.getElementById('start-docker-btn');
  if (btn) {
    btn.dataset.originalText = btn.textContent;
    btn.textContent = 'Starting...';
    btn.disabled = true;
  }
  fetch('/api/docker/start', { method: 'POST' })
    .catch(function() {
      if (btn) { btn.textContent = btn.dataset.originalText || 'Start Docker'; btn.disabled = false; }
    });
}

document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    if (_logServiceId) closeLogs();
    else if (_openGroupKey) closeDetail();
  }
});

(function() {
  var lastUpdate = Date.now();
  var failCount = 0;

  function updateTimestamp() {
    var secs = Math.round((Date.now() - lastUpdate) / 1000);
    var el = document.getElementById('last-updated');
    if (secs < 2) el.textContent = 'Just now';
    else if (secs < 60) el.textContent = secs + 's ago';
    else el.textContent = Math.round(secs / 60) + 'm ago';
  }

  function fillClass(pct) {
    if (pct > 90) return 'fill-red';
    if (pct > 70) return 'fill-yellow';
    return 'fill-green';
  }

  function usageFill(pct, pace) {
    pct = Number(pct || 0);
    if (pace === null || pace === undefined) return 'fill-green';
    var effectivePace = Math.max(Number(pace), 5);
    var ratio = pct / effectivePace;
    if (ratio >= 1.1) return 'fill-red';
    if (ratio >= 0.85) return 'fill-yellow';
    return 'fill-green';
  }

  function usageReset(iso) {
    if (!iso) return '';
    var diff = (new Date(iso) - Date.now()) / 1000;
    if (diff <= 0) return 'now';
    if (diff < 3600) return Math.round(diff / 60) + 'm';
    if (diff < 86400) return Math.round(diff / 3600) + 'h';
    return Math.round(diff / 86400) + 'd';
  }

  function usagePace(iso, periodSecs) {
    if (!iso || !periodSecs) return null;
    var resetTime = new Date(iso).getTime();
    var now = Date.now();
    var elapsed = periodSecs * 1000 - (resetTime - now);
    var pct = (elapsed / (periodSecs * 1000)) * 100;
    return Math.max(0, Math.min(100, pct));
  }

  function formatMoney(amount, currency) {
    var value = Number(amount || 0);
    var label = String(currency || 'usd').toLowerCase() === 'usd' ? '$' : String(currency || 'usd').toUpperCase() + ' ';
    var decimals = Math.abs(value) >= 100 ? 0 : 2;
    return label + value.toFixed(decimals);
  }

  function compactNumber(value) {
    var num = Number(value || 0);
    if (num >= 1000000) return (num / 1000000).toFixed(1).replace(/\.0$/, '') + 'M';
    if (num >= 1000) return (num / 1000).toFixed(1).replace(/\.0$/, '') + 'K';
    return String(Math.round(num));
  }

  function updateUsageTimestamp(elementId, headerSelector, fetchedAt) {
    var el = document.getElementById(elementId);
    if (!el && fetchedAt) {
      el = document.createElement('span');
      el.id = elementId;
      el.className = 'usage-updated';
      var header = document.querySelector(headerSelector);
      if (header) header.appendChild(el);
    }
    if (!el) return;
    if (!fetchedAt) { el.textContent = ''; return; }
    el.setAttribute('data-fetched-at', fetchedAt);
    var ageSecs = (Date.now() - new Date(fetchedAt).getTime()) / 1000;
    if (ageSecs < 60) el.textContent = 'just now';
    else if (ageSecs < 3600) el.textContent = Math.round(ageSecs / 60) + 'm ago';
    else el.textContent = Math.round(ageSecs / 3600) + 'h ago';
    var baseClass = elementId === 'cc-updated' ? 'cc-updated' : 'usage-updated';
    el.className = ageSecs > 120 ? baseClass + ' stale' : baseClass;
  }

  function updateCcTimestamp(fetchedAt) {
    updateUsageTimestamp('cc-updated', '#claude-code-group .group-header', fetchedAt);
  }

  function updateOaTimestamp(fetchedAt) {
    updateUsageTimestamp('oa-updated', '#openai-usage-group .group-header', fetchedAt);
  }

  function updateOsTimestamp(fetchedAt) {
    updateUsageTimestamp('os-updated', '#openai-subscription-group .group-header', fetchedAt);
  }

  function threadLabel(count) {
    var num = Number(count || 0);
    return num + ' ' + (num === 1 ? 'thread' : 'threads');
  }

  function updateUsageRow(rowId, fillPercent, valueText, resetText, pace) {
    var row = document.getElementById(rowId);
    if (!row) return;
    var pct = Number(fillPercent || 0);
    var fill = row.querySelector('.fill');
    if (fill) {
      fill.style.width = Math.min(Math.max(pct, 0), 100) + '%';
      fill.className = 'fill ' + usageFill(pct, pace);
    }
    var valueEl = row.querySelector('.usage-value') || row.querySelector('.claude-usage-pct');
    if (valueEl) valueEl.textContent = valueText || '';
    var resetEl = row.querySelector('.usage-reset') || row.querySelector('.claude-usage-reset');
    if (resetEl) resetEl.textContent = resetText || '';
    var marker = row.querySelector('.usage-pace-marker') || row.querySelector('.claude-pace-marker');
    if (marker) {
      if (pace !== null && pace !== undefined) {
        marker.style.left = pace + '%';
        marker.style.display = '';
      } else {
        marker.style.display = 'none';
      }
    }
  }

  function updateSubscriptionRow(rowId, obj) {
    var row = document.getElementById(rowId);
    if (!row) return;
    var valueEl = row.querySelector('.usage-value');
    if (valueEl) valueEl.textContent = compactNumber(obj && obj.tokens) + ' tokens';
    var resetEl = row.querySelector('.usage-reset');
    if (resetEl) resetEl.textContent = threadLabel(obj && obj.threads);
  }

  function refresh() {
    fetch('/api/status')
      .then(function(r) { return r.json(); })
      .then(function(data) {
        failCount = 0;
        lastUpdate = Date.now();
        document.getElementById('connection-lost').style.display = 'none';
        document.getElementById('pulse').style.background = '#3fb950';

        // Update system stats
        var sys = data.system;
        var cpuUsed = (sys.cpu.user + sys.cpu.sys).toFixed(1);
        var memPct = sys.memory.total > 0 ? ((sys.memory.used / sys.memory.total) * 100).toFixed(1) : 0;
        var diskPct = parseFloat((sys.disk.capacity || '0').replace('%', ''));

        var cards = document.querySelectorAll('#system-stats .stat-card');
        if (cards[0]) {
          cards[0].querySelector('.value').textContent = cpuUsed + '%';
          cards[0].querySelector('.sub').textContent = sys.cpu.user + '% user / ' + sys.cpu.sys + '% sys';
          var cpuFill = cards[0].querySelector('.fill');
          cpuFill.style.width = cpuUsed + '%';
          cpuFill.className = 'fill ' + fillClass(cpuUsed);
        }
        if (cards[1]) {
          cards[1].querySelector('.value').textContent = memPct + '%';
          cards[1].querySelector('.sub').textContent = (sys.memory.used / 1073741824).toFixed(1) + ' GB / ' + (sys.memory.total / 1073741824).toFixed(1) + ' GB';
          var memFill = cards[1].querySelector('.fill');
          memFill.style.width = memPct + '%';
          memFill.className = 'fill ' + fillClass(memPct);
        }
        if (cards[2]) {
          cards[2].querySelector('.value').textContent = sys.disk.capacity;
          cards[2].querySelector('.sub').textContent = sys.disk.used + ' / ' + sys.disk.size;
          var dskFill = cards[2].querySelector('.fill');
          dskFill.style.width = diskPct + '%';
          dskFill.className = 'fill ' + fillClass(diskPct);
        }
        if (cards[3]) {
          cards[3].querySelector('.value').textContent = sys.uptime;
          cards[3].querySelector('.sub').textContent = 'Load: ' + sys.load.one + ' / ' + sys.load.five + ' / ' + sys.load.fifteen;
        }

        // Update Docker card
        var dockerCard = document.getElementById('docker-card');
        if (dockerCard && sys.docker) {
          if (sys.docker.running) {
            dockerCard.querySelector('.value').textContent = 'Running';
            dockerCard.querySelector('.value').style.color = '#3fb950';
            dockerCard.querySelector('.sub').textContent = 'v' + sys.docker.version;
          } else {
            dockerCard.querySelector('.value').textContent = 'Stopped';
            dockerCard.querySelector('.value').style.color = '#f85149';
            if (sys.docker.docker_app) {
              dockerCard.querySelector('.sub').innerHTML = '<button class="log-btn" onclick="startDocker()" id="start-docker-btn">Start ' + sys.docker.docker_app + '</button>';
            } else {
              dockerCard.querySelector('.sub').textContent = 'Docker not installed';
            }
          }
        }

        // Update Claude Code usage
        var ccSummary = document.getElementById('cc-summary');
        if (ccSummary) {
          function updateClaudeRow(rowId, obj, periodSecs) {
            var pct = obj ? Number(obj.utilization || 0) : 0;
            var pace = obj ? usagePace(obj.resets_at, periodSecs) : null;
            updateUsageRow(
              rowId,
              pct,
              Math.round(pct) + '%',
              obj && obj.resets_at ? 'resets ' + usageReset(obj.resets_at) : '',
              pace
            );
          }
          if (data.claude_code && data.claude_code.available) {
            ccSummary.textContent = 'Usage';
            ccSummary.className = 'group-summary summary-ok';
            updateClaudeRow('cc-weekly-row', data.claude_code.weekly, 604800);
            updateClaudeRow('cc-session-row', data.claude_code.session, 18000);
            updateCcTimestamp(data.claude_code.fetched_at);
          } else {
            ccSummary.textContent = 'Disconnected';
            ccSummary.className = 'group-summary summary-err';
            updateClaudeRow('cc-weekly-row', null, 604800);
            updateClaudeRow('cc-session-row', null, 18000);
            updateCcTimestamp(null);
          }
        }

        // Update OpenAI API usage
        var oaSummary = document.getElementById('oa-summary');
        if (oaSummary) {
          if (data.openai_usage && data.openai_usage.available) {
            var oa = data.openai_usage;
            var monthly = oa.monthly || {};
            var daily = oa.daily || {};
            var completions = oa.completions || {};
            var periodSecs = null;
            if (oa.period && oa.period.starts_at && oa.period.resets_at) {
              periodSecs = (new Date(oa.period.resets_at) - new Date(oa.period.starts_at)) / 1000;
            }
            var monthlyPct = Number(monthly.utilization || 0);
            var dailyPct = Number(daily.utilization || 0);
            var monthlyPace = monthly.budget ? usagePace(monthly.resets_at, periodSecs) : null;
            var dailyPace = daily.budget ? usagePace(daily.resets_at, 86400) : null;
            var monthlyValue = monthly.budget ? Math.round(monthlyPct) + '%' : formatMoney(monthly.cost, monthly.currency);
            var monthlyReset = monthly.budget
              ? formatMoney(monthly.cost, monthly.currency) + ' / ' + formatMoney(monthly.budget, monthly.currency)
              : (monthly.resets_at ? 'resets ' + usageReset(monthly.resets_at) : '');

            oaSummary.textContent = 'Usage';
            oaSummary.className = 'group-summary summary-ok';
            updateUsageRow('oa-monthly-row', monthlyPct, monthlyValue, monthlyReset, monthlyPace);
            updateUsageRow(
              'oa-daily-row',
              dailyPct,
              formatMoney(daily.cost, daily.currency),
              daily.resets_at ? 'resets ' + usageReset(daily.resets_at) : '',
              dailyPace
            );
            var meta = document.getElementById('oa-meta');
            if (meta) {
              meta.textContent = Number(completions.requests || 0) + ' req · ' + compactNumber(completions.total_tokens) + ' tokens this month';
            }
            updateOaTimestamp(oa.fetched_at);
          } else {
            oaSummary.textContent = 'Disconnected';
            oaSummary.className = 'group-summary summary-err';
            updateUsageRow('oa-monthly-row', 0, '$0.00', '', null);
            updateUsageRow('oa-daily-row', 0, '$0.00', '', null);
            var emptyMeta = document.getElementById('oa-meta');
            if (emptyMeta) emptyMeta.textContent = '0 req · 0 tokens this month';
            updateOaTimestamp(null);
          }
        }

        // Update OpenAI subscription activity
        var osSummary = document.getElementById('os-summary');
        if (osSummary) {
          if (data.openai_subscription && data.openai_subscription.available) {
            var os = data.openai_subscription;
            var windows = os.windows || {};
            var plan = os.plan || {};
            osSummary.textContent = 'Local Activity';
            osSummary.className = 'group-summary summary-ok';
            updateSubscriptionRow('os-three-hour-row', windows.three_hour);
            updateSubscriptionRow('os-today-row', windows.today);
            updateSubscriptionRow('os-seven-day-row', windows.seven_day);
            updateSubscriptionRow('os-thirty-day-row', windows.thirty_day);
            var planMeta = document.getElementById('os-plan-meta');
            if (planMeta) {
              planMeta.textContent = plan.name
                ? plan.name + ' · ' + (plan.limit_summary || 'limit summary unavailable')
                : 'Plan not configured';
            }
            var note = document.getElementById('os-note');
            if (note) note.textContent = os.note || '';
            updateOsTimestamp(os.fetched_at);
          } else {
            osSummary.textContent = 'Unavailable';
            osSummary.className = 'group-summary summary-err';
            updateSubscriptionRow('os-three-hour-row', null);
            updateSubscriptionRow('os-today-row', null);
            updateSubscriptionRow('os-seven-day-row', null);
            updateSubscriptionRow('os-thirty-day-row', null);
            var emptyPlanMeta = document.getElementById('os-plan-meta');
            if (emptyPlanMeta) emptyPlanMeta.textContent = 'Plan not configured';
            var emptyNote = document.getElementById('os-note');
            if (emptyNote) {
              emptyNote.textContent = data.openai_subscription && data.openai_subscription.reason
                ? data.openai_subscription.reason
                : 'No local Codex subscription activity is available.';
            }
            updateOsTimestamp(null);
          }
        }

        // Update auth state from API response
        if (data.auth_enabled !== undefined) {
          _authEnabled = data.auth_enabled;
          if (data.authenticated !== undefined) {
            _isAuthenticated = data.authenticated;
          }
        }

        // Store last data for detail modal
        _lastData = data;

        // Update service summary cards
        Object.keys(data.services).forEach(function(key) {
          var group = data.services[key];
          var card = document.querySelector('.service-summary-card[data-group="' + key + '"]');
          if (!card) return;

          var services = group.services;
          var okCount = services.filter(function(s) { return s.status === 'ok'; }).length;
          var errCount = services.filter(function(s) { return s.status === 'error'; }).length;
          var warnCount = services.filter(function(s) { return s.status === 'warning'; }).length;
          var runningCount = services.filter(function(s) { return s.state === 'running'; }).length;
          var total = services.length;

          card.querySelector('.value').textContent = okCount + '/' + total;
          card.querySelector('.sub').textContent = runningCount + ' running';
          card.style.borderColor = errCount > 0 ? '#f8514940' : warnCount > 0 ? '#d2992240' : '#21262d';

          var countsHtml = '';
          if (errCount > 0) countsHtml += '<span class="count-err">' + errCount + ' failed</span>';
          if (warnCount > 0) countsHtml += '<span class="count-warn">' + warnCount + ' warning</span>';
          if (errCount === 0 && warnCount === 0) countsHtml += '<span class="count-ok">all healthy</span>';
          card.querySelector('.summary-counts').innerHTML = countsHtml;
        });

        // If detail modal is open, re-render it live
        if (_openGroupKey && data.services[_openGroupKey] && (!_authEnabled || _isAuthenticated)) {
          renderDetailModal(_openGroupKey, data.services[_openGroupKey]);
        }

        // Update favicon based on overall status
        var allOk = Object.keys(data.services).every(function(key) {
          return data.services[key].services.every(function(s) { return s.status === 'ok'; });
        });
        if (data.config && data.config.features && data.config.features.docker && data.system.docker) {
          allOk = allOk && data.system.docker.running;
        }
        var link = document.querySelector('link[rel="icon"]');
        if (link) link.href = '/favicon.svg?t=' + Date.now();
        var dashTitle = (data.config && data.config.title) ? data.config.title : 'Status Dashboard';
        document.title = (allOk ? '\u2705 ' : '\ud83d\udd34 ') + dashTitle;

        // Update footer
        document.querySelector('.footer').textContent = 'Generated at ' + data.generated_at + ' \u00b7 Refreshes every 15s';
      })
      .catch(function() {
        failCount++;
        if (failCount >= 2) {
          document.getElementById('connection-lost').style.display = 'block';
          document.getElementById('pulse').style.background = '#f85149';
        }
      });
  }

  refresh();
  setInterval(refresh, 15000);
  setInterval(updateTimestamp, 1000);
  setInterval(function() {
    var ccEl = document.getElementById('cc-updated');
    if (ccEl && ccEl.getAttribute('data-fetched-at')) {
      updateCcTimestamp(ccEl.getAttribute('data-fetched-at'));
    }
    var oaEl = document.getElementById('oa-updated');
    if (oaEl && oaEl.getAttribute('data-fetched-at')) {
      updateOaTimestamp(oaEl.getAttribute('data-fetched-at'));
    }
    var osEl = document.getElementById('os-updated');
    if (osEl && osEl.getAttribute('data-fetched-at')) {
      updateOsTimestamp(osEl.getAttribute('data-fetched-at'));
    }
  }, 15000);
})();
</script>
</body>
</html>
